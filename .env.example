# Create a dedicated SysMan app credential in OuthMan. Never commit real values.
# Within Docker, 127.0.0.1 points to SysMan, not the OuthMan host.
OUTHMAN_BASE_URL=https://outhman.example.com
OUTHMAN_APP_ID=
OUTHMAN_APP_SECRET=
# Comma-separated canonical OuthMan usernames; each is a SysMan operator.
SYSMAN_ALLOWED_USERS=
# Leave empty for the supplied localhost/SSH-tunnel deployment.
SYSMAN_PUBLIC_ORIGIN=
SYSMAN_COOKIE_SECURE=false
# Only enable for a trusted, isolated network that cannot use HTTPS.
OUTHMAN_ALLOW_INSECURE_HTTP=false
